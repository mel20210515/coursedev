# ClassBuild - API Keys
# For production-safe OpenAI usage, set OPENAI_API_KEY on the server.
# In local development, Vite can proxy to OpenAI when OPENAI_API_KEY is set.

# Required server env - OpenAI API key
OPENAI_API_KEY=sk-...

# Frontend flag - route OpenAI calls through /api/openai/responses
VITE_USE_OPENAI_PROXY=true

# Optional - ElevenLabs API key for voice narration
ELEVENLABS_API_KEY=

# Optional - Google Gemini API key for AI-generated infographics
GEMINI_API_KEY=
